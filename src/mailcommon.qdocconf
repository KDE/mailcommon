include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = MailCommon
moduleheader = mailcommon_qdocmoduleheader.h
description = MailCommon library.


documentationinheaders = true

headers += \
    collectionpage/attributes/expirecollectionattribute.h \
    collectionpage/collectionexpirypage.h \
    collectionpage/collectionexpirywidget.h \
    collectionpage/collectiongeneralpage.h \
    collectionpage/collectiongeneralwidget.h \
    collectionpage/collectiontemplateswidget.h \
    collectionpage/collectionviewwidget.h \
    dbusoperators.h \
    filter/filteractions/filteraction.h \
    filter/filteractions/filteractiondict.h \
    filter/filterimporter/filterimporterabstract.h \
    filter/filterimporter/filterimporterbalsa.h \
    filter/filterimporter/filterimporterclawsmail.h \
    filter/filterimporterexporter.h \
    filter/filterimporterpathcache.h \
    filter/filterlog.h \
    filter/filtermanager.h \
    filter/itemcontext.h \
    filter/kmfilterdialog.h \
    filter/mailfilter.h \
    folder/accountconfigorderdialog.h \
    folder/entitycollectionorderproxymodel.h \
    folder/favoritecollectionorderproxymodel.h \
    folder/foldercollectionmonitor.h \
    folder/folderrequester.h \
    folder/folderselectiondialog.h \
    folder/foldersettings.h \
    folder/foldertreeview.h \
    folder/foldertreewidget.h \
    folder/foldertreewidgetproxymodel.h \
    interfaces/mailinterfaces.h \
    job/backupjob.h \
    job/folderjob.h \
    job/jobscheduler.h \
    kernel/mailkernel.h \
    mailcommon_qdocmoduleheader.h \
    mdn/mdnwarningjob.h \
    search/searchpattern.h \
    search/searchpatternedit.h \
    search/searchrule/searchrule.h \
    search/searchrule/searchrulestatus.h \
    snippets/snippetsmanager.h \
    snippets/snippetsmodel.h \
    snippets/snippettreeview.h \
    snippets/snippetwidget.h \
    snooze/attributes/snoozeattribute.h \
    tag/addtagdialog.h \
    tag/tag.h \
    tag/tagwidget.h \
    util/cryptoutils.h \
    util/mailutil.h \
    util/resourcereadconfigfile.h \
    widgets/favoritecollectionwidget.h \
    widgets/redirectdialog.h
sourcedirs += .

excludedirs += \
    collectionpage/autotests \
    filter/autotests \
    filter/filterimporter/autotests \
    filter/tests \
    search/autotests \
    snippets/autotests \
    snooze/attributes/autotests

outputformats = HTML

depends += \
    qtcore \
    qtgui \
    qtwidgets \
    kmime \
    kmailtransport \
    identitymanagementcore \
    libkdepim \
    pimcommon \
    messagecore \
    messagecomposer \
    messageviewer \
    templateparser \
    textcustomeditor

navigation.landingpage = "MailCommon"

qhp.projects            = mailcommon

qhp.mailcommon.file                = mailcommon.qhp
qhp.mailcommon.namespace           = org.kde.mailcommon.$QT_VERSION_TAG
qhp.mailcommon.virtualFolder       = mailcommon
qhp.mailcommon.indexTitle          = MailCommon
qhp.mailcommon.indexRoot           =

qhp.mailcommon.subprojects         = classes
qhp.mailcommon.subprojects.classes.title = C++ Classes
qhp.mailcommon.subprojects.classes.indexTitle = MailCommon C++ Classes
qhp.mailcommon.subprojects.classes.selectors = class fake:headerfile
qhp.mailcommon.subprojects.classes.sortPages = true

tagfile = mailcommon.tags
